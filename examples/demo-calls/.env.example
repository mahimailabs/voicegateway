# Copy to .env and fill in. .env is gitignored.

# Your LiveKit project. The demo uses LiveKit Inference, which runs on LiveKit Cloud, so
# these are a LiveKit Cloud project's URL, key and secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Both from the VoiceGateway console's "Connect your agent" panel, and both the same URL:
# https://<host>/ingest/<org>/<project>
# LiveKit's uploader sends spans, turns and the recording here.
LIVEKIT_OBSERVABILITY_URL=
# voicegateway.attach() sends the scenario field here.
VOICEGATEWAY_URL=
