# Copy to .env and fill in. .env is gitignored.

# Your LiveKit project. The example uses LiveKit Inference, which runs on
# LiveKit Cloud, so these are a LiveKit Cloud project's URL, key and secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Copied from the VoiceGateway console's "Connect your agent" panel:
# https://<host>/ingest/<org>/<project>
LIVEKIT_OBSERVABILITY_URL=
