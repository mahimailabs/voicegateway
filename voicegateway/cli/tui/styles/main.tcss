/* voicegateway/cli/tui/styles/main.tcss
 *
 * v0.1.1 brand foundation. The orange #D85A30 matches the
 * marketing-site accent; mahimairaja can swap to the canonical
 * brand value at release time without touching Python.
 *
 * Per-widget DEFAULT_CSS owns component-level layout (heights,
 * paddings, internal grids). This file owns the cross-screen
 * brand chrome: focus rings, the active-tab indicator, and the
 * Header / Footer accent.
 *
 * Refinery rule "no decorative borders unless they carry
 * information": every border in this file flags a state
 * (focus / active tab / modal panel) the user needs to read.
 */

/* Header keeps the boost background Textual ships and adds a
 * brand-orange tinted bold to the version label so the chip is
 * unambiguous on both 24-bit and 256-color terminals. */
Header {
    color: #D85A30;
    text-style: bold;
}

/* Focus ring: brand orange on every focusable widget so the user
 * always knows where the keyboard is. ``outline`` is overlay, not
 * layout, so it does not push content around when a row gains
 * focus. */
*:focus {
    outline: tall #D85A30;
}

/* Active-tab indicator. ContentSwitcher hides the inactive
 * children and shows the current one; we add a left-edge
 * orange bar to reinforce "this tab is live" beyond just
 * "this tab is the only thing on screen". The hidden tabs
 * still carry the dim variant so a future split-screen
 * layout (v0.2.0+) inherits the right base. */
#content > * {
    border-left: thick #2A2A2A;
}
#content > Container.-content-switcher-current {
    border-left: thick #D85A30;
}

/* Modal screens (SessionDetailScreen, HelpOverlay) inherit the
 * brand accent on their thick border via $accent already, so we
 * only need to ensure the background stays readable on terminals
 * that downgrade $panel to a near-black. */
ModalScreen > Container {
    background: $panel;
}

/* Cross-screen utility classes. Hoisted from per-screen
 * DEFAULT_CSS so the four tab panels share one source of truth
 * for the header bar, list surface, and empty-state body. Adding
 * a class to a Label / VerticalScroll / Static in any screen's
 * compose() picks the rule up automatically. */

/* The single-row header bar at the top of each tab. Boost
 * background reads as a subtle separator from the body content;
 * the brand-orange focus outline (above) layers cleanly on top
 * when keyboard focus lands on something inside the header. */
.tab-header {
    height: 1;
    padding: 0 1;
    background: $boost;
}

/* Standard list-scroll surface used by Sessions / Providers /
 * any future row-list screen. Surface tone for the scrollbar
 * track keeps it readable without competing with the brand-
 * orange thumb Textual paints by default. */
.tui-list {
    scrollbar-background: $surface;
}

/* Empty-state body. The muted text colour signals "nothing here
 * yet" without flagging an error; centred so the message reads
 * as the deliberate placeholder it is. Used by Sessions and
 * Providers; the Logs / Costs panels render their own empty
 * shapes inline. */
.empty-state {
    height: 100%;
    content-align: center middle;
    color: $text-muted;
}
