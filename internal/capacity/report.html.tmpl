<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Capacity: {{.Agent}}</title>
<style>
:root{--bg:#f7f8fa;--surface:#fff;--fg:#111827;--muted:#525b6b;--line:#dfe3ea;--accent:#0b5fd9;--good:#0a7a52;--bad:#b42318;--warn:#a14a07;
--sans:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}
@media (prefers-color-scheme:dark){:root{--bg:#0e1116;--surface:#161b22;--fg:#e8ebf0;--muted:#a3adbb;--line:#2a313c;--accent:#6aa6ff;--good:#3fc79a;--bad:#ff8a80;--warn:#f0a94b;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.55 var(--sans)}
main{max-width:880px;margin:0 auto;padding:40px 16px 56px;display:flex;flex-direction:column;gap:28px}
h1{font-size:clamp(24px,4.5vw,34px);line-height:1.15;margin:0;font-weight:650;font-family:var(--mono)}
h2{font-size:19px;margin:0 0 10px;font-weight:650}
p{margin:0 0 8px;max-width:68ch}
.eyebrow{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:600;margin:0 0 6px}
.meta{color:var(--muted);font-size:14px;margin-top:6px}
.verdict{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:24px;display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center}
.big{font-size:88px;line-height:.9;font-weight:700;color:var(--accent);font-variant-numeric:tabular-nums}
.big small{display:block;font-size:14px;color:var(--muted);font-weight:500;margin-top:10px;max-width:20ch;line-height:1.35}
.verdict ul,.next ul{margin:8px 0 0;padding-left:18px;color:var(--fg)}
.next{border-left:3px solid var(--accent);padding:4px 0 4px 16px}
.chart{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px}
svg{width:100%;height:auto;display:block}
.axis{stroke:var(--line)}
.tick{fill:var(--muted);font:12px var(--sans)}
.bar{fill:var(--accent);opacity:.85}.bar.refused{fill:var(--bad);opacity:.55}
.line{fill:none;stroke-width:2.5}.median{stroke:var(--fg)}.p95{stroke:var(--warn);stroke-dasharray:6 4}
.legend{display:flex;flex-wrap:wrap;gap:16px;font-size:13px;color:var(--muted);margin-top:8px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px}
.scroll{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:12px}
table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}
th,td{text-align:right;padding:9px 12px;border-bottom:1px solid var(--line);white-space:nowrap}
tr:last-child td{border-bottom:0}
th:first-child,td:first-child,th:nth-child(2),td:nth-child(2){text-align:left}
th{font-size:12px;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);font-weight:600}
.passed{color:var(--good);font-weight:600}.failed{color:var(--bad);font-weight:600}.inconclusive{color:var(--warn);font-weight:600}
li{margin-bottom:4px}
details{font-size:14px;color:var(--muted)}
summary{cursor:pointer;font-weight:600;color:var(--fg)}
details .scroll{margin:12px 0}
footer{border-top:1px solid var(--line);padding-top:14px;font-size:13px;color:var(--muted)}
a{color:var(--accent)}
@media (max-width:640px){.verdict{grid-template-columns:1fr;gap:12px}.big{font-size:64px}th,td{padding:8px}table{font-size:13px}}
</style>
</head>
<body>
<main>
<header>
<p class="eyebrow">Voice agent capacity test</p>
<h1>{{.Agent}}</h1>
<p class="meta">{{.When}}{{with .ServerCount}} · {{.}}{{end}}{{with .LiveKitHost}} · LiveKit {{.}}{{end}}</p>
</header>

<section class="verdict" aria-label="Result">
{{if .Capacity}}<div class="big">{{.Capacity}}<small>calls at once{{with .AgentServer}} on {{.}}{{end}}</small></div>{{else}}<div class="big">none<small>no step passed</small></div>{{end}}
<div><p><strong>{{.Verdict}}</strong></p>{{if .Limit}}<ul>{{range .Limit}}<li>{{.}}</li>{{end}}</ul>{{end}}</div>
</section>
{{if .Next}}
<section class="next" aria-label="What it takes">
<h2>What it takes</h2>
<ul>{{range .Next}}<li>{{.}}</li>{{end}}</ul>
</section>
{{end}}
<section>
<h2>Calls and answer time</h2>
<div class="chart">
{{chart .}}
<div class="legend"><span><i style="background:var(--accent)"></i>Got the agent</span><span><i style="background:var(--bad);opacity:.55"></i>Refused</span><span><i style="background:var(--fg);height:3px;vertical-align:3px"></i>Median answer</span><span><i style="background:var(--warn);height:3px;vertical-align:3px"></i>p95 answer</span></div>
</div>
</section>

<section>
<h2>Step by step</h2>
<div class="scroll" tabindex="0" role="region" aria-label="Step by step results"><table>
<thead><tr><th scope="col">Calls at once</th><th scope="col">Result</th><th scope="col">Got the agent</th><th scope="col">Median answer</th><th scope="col">p95 answer</th></tr></thead>
<tbody>{{range .Ordered}}<tr><td>{{.Calls}}{{mark .Refine}}</td><td class="{{.Outcome}}">{{.Outcome}}</td><td>{{.Joined}} of {{.Calls}}</td><td>{{secs .Answers.Median}}</td><td>{{secs .Answers.P95}}</td></tr>{{end}}</tbody>
</table></div>
</section>

<details>
<summary>All measurements and method</summary>
<div class="scroll" tabindex="0" role="region" aria-label="All measurements"><table>
<thead><tr><th scope="col">Calls</th><th scope="col">Refused</th><th scope="col">Dropped</th><th scope="col">Answers</th><th scope="col">Over 1 s</th><th scope="col">Slowest</th><th scope="col">Slowest join</th><th scope="col">Tester CPU</th></tr></thead>
<tbody>{{range .Ordered}}<tr><td>{{.Calls}}{{mark .Refine}}</td><td>{{.Pending}}</td><td>{{.Dropped}}</td><td>{{.Answers.Count}}</td><td>{{pct .Answers.SlowShare}}</td><td>{{secs .Answers.Slowest}}</td><td>{{secs .SlowestJoin}}</td><td>{{pct100 .TesterCPU}}</td></tr>{{end}}</tbody>
</table></div>
<p>{{.Method}}</p>
</details>

<footer><a href="{{.Link}}">{{.MeasuredWith}}</a> {{.Version}} · run {{.RunID}}</footer>
</main>
</body>
</html>
