---
import Base from '../layouts/Base.astro';
import CallRecord from '../components/CallRecord.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import { DOCS, GITHUB } from '../lib/links';

const records = [
  {
    title: 'Cost per call',
    text: 'Every request priced from the voice-prices catalog and split across STT, LLM and TTS. Each row names the rate that priced it.',
  },
  {
    title: 'Reconciliation',
    text: '`voicegw reconcile` checks recorded totals against the provider’s own usage export, model by model.',
  },
  {
    title: 'Latency by stage',
    text: 'Time to first audio, time to first byte and p95 for each stage, so you see where the milliseconds go.',
  },
  {
    title: 'Call records',
    text: 'One record per phone or web call, expandable into a timeline of every STT, LLM and TTS request in it.',
  },
  {
    title: 'Spend control',
    text: '`guard()` adds a fallback chain, a rate limit and a daily budget to one provider, as a drop-in.',
  },
  {
    title: 'Diagnostics',
    text: 'LiveKit credential and connectivity checks, so a broken key shows up here before a caller hears it.',
  },
];

const code = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>');
const providers = ['OpenAI', 'Deepgram', 'Anthropic', 'Groq', 'Cartesia', 'ElevenLabs', 'AssemblyAI', 'Whisper', 'Ollama', 'Kokoro', 'Piper'];
---
<Base>
  <section class="shell hero">
    <div class="hero-copy">
      <h1>See what every voice call costs.</h1>
      <p class="lead">
        Add one line to a LiveKit or Pipecat agent. Every STT, LLM and TTS call is priced and timed, per call,
        on your own keys. VoiceGateway stores telemetry rows, never your audio.
      </p>
      <div class="install">
        <code><span class="muted" aria-hidden="true">$</span> pip install voicegateway</code>
        <button type="button" class="copy" data-copy="pip install voicegateway" aria-label="Copy the install command">Copy</button>
      </div>
      <div class="ctas">
        <a class="btn btn-primary" href="/demo">Open the live demo</a>
        <a class="btn" href={`${DOCS}/quickstart`}>Read the quickstart</a>
      </div>
      <p class="facts mono">AGPL-3.0 · Self-hosted · Your keys · Never in the audio path</p>
    </div>
    <CallRecord />
  </section>

  <section class="shell chapter split">
    <div>
      <h2>One line in your agent.</h2>
      <p class="sub">
        <code>attach()</code> meters the STT, LLM and TTS instances you already construct. It reads cost and timing
        off each call and never touches a request.
      </p>
      <a class="prose-link" href={`${DOCS}/attach`}>How attach() works</a>
    </div>
    <pre class="code" aria-label="agent.py"><code><span class="k">from</span> voicegateway <span class="k">import</span> attach

session = AgentSession(stt=stt, llm=llm, tts=tts)
attach(session)  <span class="c"># every call, priced and timed</span></code></pre>
  </section>

  <section class="shell chapter">
    <h2 class="wide">Every dollar and millisecond, on the record.</h2>
    <p class="sub">One telemetry row per request, rolled up into the views a voice team reaches for.</p>
    <dl class="grid">
      {records.map((r) => (
        <div class="cell">
          <dt>{r.title}</dt>
          <dd set:html={code(r.text)} />
        </div>
      ))}
    </dl>
  </section>

  <section class="shell chapter">
    <h2 class="wide">See it before you install.</h2>
    <p class="sub">
      A real VoiceGateway dashboard on example data: cost per agent, the STT, LLM and TTS latency split, fleet
      memory, reconciliation. No signup, nothing to run.
    </p>
    <a class="shot" href="/demo" aria-label="Open the live VoiceGateway demo dashboard">
      <img src="/demo-preview.png" width="1360" height="860" loading="lazy" alt="The VoiceGateway dashboard on example data: spend, fleet, and cost and latency per agent." />
    </a>
  </section>

  <section class="shell chapter split">
    <div>
      <h2>Every provider you run, on one meter.</h2>
      <p class="sub">
        VoiceGateway meters the plugins you already use; it never picks your providers. The catalog prices the common
        ones, and <code>voicegw prices gaps</code> lists anything it cannot, heaviest traffic first.
      </p>
    </div>
    <ul class="providers mono" aria-label="Providers">
      {providers.map((p) => <li>{p}</li>)}
    </ul>
  </section>

  <section class="shell chapter split">
    <div>
      <h2>Run it on your own server.</h2>
      <p class="sub">One collector for every agent. Your keys stay with your agents; the collector only ever sees telemetry rows.</p>
      <a class="prose-link" href={`${DOCS}/self-hosting`}>Self-hosting guide</a>
    </div>
    <ol class="steps">
      <li>
        <h3>Start a collector</h3>
        <p>It installs Docker if needed, generates the secrets, pins the image and waits for a healthy container.</p>
        <pre class="code"><code>curl -fsSL https://voicegateway.dev/collector.sh | bash</code></pre>
      </li>
      <li>
        <h3>Point your agents at it</h3>
        <p>Three variables. <code>attach()</code> reads them; the agent code does not change.</p>
        <pre class="code"><code>export VOICEGW_COLLECTOR_URL=https://collector.example.com
export VOICEGW_API_KEY=&lt;the key the script printed&gt;
export VOICEGW_PROJECT=my-agent</code></pre>
      </li>
      <li>
        <h3>Place a call</h3>
        <p>Rows land as the call runs: cost, latency, the whole call.</p>
      </li>
    </ol>
  </section>

  <section class="shell chapter">
    <div class="hosted">
      <h2>Want a hosted version?</h2>
      <p class="sub">
        The engine is open source and yours to self-host today. A hosted version, with a managed collector and a
        shared dashboard, is on the roadmap if enough teams want it. Leave your email and we write once, when it ships.
      </p>
      <WaitlistForm />
      <p class="muted small">Would rather read the code? <a href={GITHUB}>VoiceGateway on GitHub</a>.</p>
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = 'Copy'), 1600);
      } catch {
        button.textContent = 'Select and copy';
      }
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
    padding-top: 5.5rem;
    padding-bottom: 5rem;
  }
  h1 {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }
  .lead { margin-top: 1.5rem; font-size: 1.125rem; line-height: 1.65; color: var(--vg-prose); max-width: 34rem; }
  .install {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    margin-top: 2rem; max-width: 26rem;
    padding: 0.625rem 0.625rem 0.625rem 1rem;
    border: 1px solid var(--vg-line); border-radius: var(--radius);
    background: var(--vg-surface);
  }
  .install code { font-size: 0.9375rem; }
  .copy {
    border: 1px solid var(--vg-line-strong); border-radius: 0.25rem;
    background: none; color: var(--vg-muted); cursor: pointer;
    font: 500 0.8125rem var(--sans); padding: 0.3rem 0.6rem;
  }
  .copy:hover { color: var(--vg-ink); }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  .facts { margin-top: 2rem; font-size: 0.8125rem; color: var(--vg-muted); }

  .chapter { padding-top: 5.5rem; padding-bottom: 1rem; border-top: 1px solid var(--vg-line); margin-top: 3rem; }
  .hero + .chapter { margin-top: 0; }
  h2 { font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.08; max-width: 16ch; }
  h2.wide { max-width: 22ch; }
  .sub { margin-top: 1rem; color: var(--vg-prose); line-height: 1.7; max-width: 38rem; margin-bottom: 1.25rem; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 3.5rem; align-items: start; }

  :where(p, dd) code { font-size: 0.875em; padding: 0.1rem 0.3rem; border-radius: 0.25rem; background: var(--vg-surface); border: 1px solid var(--vg-line); }

  .code {
    margin: 0; padding: 1.25rem 1.5rem;
    border: 1px solid var(--vg-line); border-radius: 0.6rem;
    background: var(--vg-surface);
    font-size: 0.875rem; line-height: 1.75; overflow-x: auto;
  }
  .code .k { color: var(--vg-accent); }
  .code .c { color: var(--vg-muted); }

  .grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    margin: 2.5rem 0 0; background: var(--vg-line); border: 1px solid var(--vg-line);
    border-radius: 0.75rem; overflow: hidden;
  }
  .cell { background: var(--vg-bg); padding: 1.75rem 1.5rem; }
  dt { font-weight: 500; font-size: 1.0625rem; letter-spacing: -0.01em; }
  dd { margin: 0.6rem 0 0; color: var(--vg-muted); line-height: 1.65; font-size: 0.9375rem; }

  .shot {
    display: block; margin-top: 2rem;
    border: 1px solid var(--vg-line); border-radius: 0.75rem; overflow: hidden;
    transition: border-color 0.3s var(--vg-ease-out), transform 0.4s var(--vg-ease-out);
  }
  .shot:hover { border-color: var(--vg-line-strong); transform: translateY(-2px); }
  .shot img { display: block; width: 100%; height: auto; }

  .providers {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem; align-content: start;
  }
  .providers li {
    padding: 0.45rem 0.8rem; border: 1px solid var(--vg-line); border-radius: 999px;
    font-size: 0.8125rem; color: var(--vg-prose);
  }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; counter-reset: step; }
  .steps li { counter-increment: step; display: grid; gap: 0.6rem; }
  .steps h3 { font-size: 1.125rem; letter-spacing: -0.02em; }
  .steps h3::before { content: counter(step) '. '; color: var(--vg-muted); font-variant-numeric: tabular-nums; }
  .steps p { color: var(--vg-muted); line-height: 1.65; }

  .hosted { max-width: 40rem; }
  .small { margin-top: 1.25rem; font-size: 0.875rem; }

  @media (max-width: 56rem) {
    .hero, .split { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero { padding-top: 3.5rem; }
    .grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 36rem) {
    .grid { grid-template-columns: 1fr; }
    .chapter { padding-top: 4rem; }
  }
</style>
