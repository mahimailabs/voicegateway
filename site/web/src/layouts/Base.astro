---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import { DOCS, GITHUB } from '../lib/links';

interface Props {
  title?: string;
  description?: string;
}

const DEFAULT_TITLE = 'VoiceGateway: the open-source profiler for voice agents';
const DEFAULT_DESCRIPTION =
  'Add one line and every STT, LLM and TTS call in your voice agent is priced and timed. Works with LiveKit and Pipecat, on your own keys. VoiceGateway stores telemetry rows, never your audio.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;
const fullTitle = title ? `${title} · VoiceGateway` : DEFAULT_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;

---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VoiceGateway" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline>
      // Before first paint: dark unless the visitor chose light.
      try {
        if (localStorage.getItem('vg-theme') === 'light') document.documentElement.classList.remove('dark');
      } catch {}
    </script>
  </head>
  <body>
    <header class="nav">
      <div class="shell nav-row">
        <a href="/" class="wordmark" aria-label="VoiceGateway home">
          <Mark />
          <span>VoiceGateway</span>
        </a>
        <nav aria-label="Primary" class="nav-links">
          <a href="/demo">Demo</a>
          <a href={DOCS}>Docs</a>
          <a href={GITHUB} class="wide-only">GitHub</a>
          <button type="button" class="theme" data-theme-toggle aria-label="Switch light or dark theme">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="foot">
      <div class="shell foot-row">
        <p class="muted">© 2026 VoiceGateway. AGPL-3.0 licensed.</p>
        <nav aria-label="Footer" class="foot-links">
          <a href="/demo">Demo</a>
          <a href={DOCS}>Docs</a>
          <a href={GITHUB}>GitHub</a>
          <a href={`${GITHUB}/releases`}>Changelog</a>
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem('vg-theme', dark ? 'dark' : 'light'); } catch {}
      });
    </script>
    <script>
      // PostHog, bundled from npm and loaded only when a key is set at build time.
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      if (key) {
        import('posthog-js').then(({ default: posthog }) =>
          posthog.init(key, {
            api_host: import.meta.env.PUBLIC_POSTHOG_HOST || 'https://us.i.posthog.com',
            autocapture: true,
            capture_pageview: true,
          }),
        );
      }
    </script>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--vg-bg) 88%, transparent);
    backdrop-filter: saturate(1.2) blur(10px);
    border-bottom: 1px solid var(--vg-line);
  }
  .nav-row { display: flex; align-items: center; justify-content: space-between; height: 3.5rem; }
  .wordmark {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-weight: 500; letter-spacing: -0.02em; text-decoration: none;
  }
  .nav-links { display: flex; align-items: center; gap: 1.5rem; font-size: 0.9375rem; }
  .nav-links a { text-decoration: none; color: var(--vg-muted); transition: color 0.2s; }
  .nav-links a:hover { color: var(--vg-ink); }
  .theme {
    display: inline-grid; place-items: center; width: 2rem; height: 2rem;
    border: 1px solid var(--vg-line); border-radius: var(--radius);
    background: none; color: var(--vg-muted); cursor: pointer;
  }
  .theme:hover { color: var(--vg-ink); border-color: var(--vg-line-strong); }

  .foot { border-top: 1px solid var(--vg-line); margin-top: 6rem; }
  .foot-row {
    display: flex; flex-wrap: wrap; gap: 1rem 2rem;
    align-items: center; justify-content: space-between;
    padding-top: 2rem; padding-bottom: 2.5rem; font-size: 0.875rem;
  }
  .foot-links { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .foot-links a { color: var(--vg-muted); text-decoration: none; }
  .foot-links a:hover { color: var(--vg-ink); }

  @media (max-width: 30rem) {
    .nav-links { gap: 1rem; }
    .nav-links .wide-only { display: none; }
  }
</style>
