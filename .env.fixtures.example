# .env.fixtures.example
#
# Copy to .env.fixtures (gitignored) and fill in real keys to
# record streaming fixtures via scripts/record_streaming_fixtures.py.
#
# These keys are dev-only. They are NOT used by CI; fixtures are
# committed to tests/fixtures/streaming/ so CI can replay them via
# HTTP mocking without ever calling real provider APIs.
#
# Cost: each recording is a tiny call (sub-cent for the canonical
# test prompts: ~20-token LLM responses, a 3-second test audio
# clip, a single-sentence TTS render).
#
# Usage:
#   1. cp .env.fixtures.example .env.fixtures
#   2. Edit .env.fixtures and fill in the keys for the providers
#      you intend to record.
#   3. Source the file before running the recorder:
#        set -a; source .env.fixtures; set +a
#        python scripts/record_streaming_fixtures.py --record \
#          --provider openai --modality llm --model gpt-4o-mini --mode batch

# OpenAI: LLM recording (gpt-4o-mini and similar). Required for
# Phase 3.2's "Record OpenAI gpt-4o-mini batch + stream fixtures"
# sub-item.
OPENAI_API_KEY=

# Deepgram: STT recording (nova-3 and similar). Required for the
# Deepgram fixture sub-items in Phase 3.2.
DEEPGRAM_API_KEY=

# Cartesia: TTS recording (sonic-3 and similar). Required for the
# Cartesia fixture sub-items in Phase 3.2.
CARTESIA_API_KEY=

# Optional: Cartesia voice ID for TTS recording. Defaults to the
# example yaml's voice if the recorder script does not set its own.
# CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Stretch providers (Phase 3.2 stretch goals):

# ANTHROPIC_API_KEY=
# ASSEMBLYAI_API_KEY=
# ELEVENLABS_API_KEY=
