{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "openapi-ts.config.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  // Tests that import the app compile with the app's settings (tsconfig.test.json).
  "exclude": ["tests/mock-api.test.ts", "tests/api-client.test.ts", "tests/call-filters.test.ts", "tests/scope.test.ts"]
}
